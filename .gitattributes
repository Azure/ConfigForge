# Default to automatic text detection.
* text=auto

# v0.2.0+: shell scripts must keep LF line endings even on Windows checkouts.
# Without this, shell helpers such as scripts/verify-no-cli-binary.sh can fail
# with "set: pipefail: invalid option name" on Linux runners because the
# shebang and set lines come through with trailing CR. The wired packaging
# guard is scripts/verify-public-package-assets.mjs; verify-no-cli-binary.sh
# remains available as a manual check.
*.sh                                text eol=lf
scripts/**                          text eol=lf

# Dev-only oscfg binaries are never normalized if a contributor drops one
# into the local convenience directory.
resources/oscfg/win32-x64/oscfg.exe binary
resources/oscfg/win32-x64/*.pdb     binary
resources/oscfg/linux-x64/oscfg     binary
